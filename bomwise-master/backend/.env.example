# Database
DATABASE_URL=postgresql://bomexplorer:bomexplorer@localhost:5432/bomexplorer

# Redis (used by Celery task queue)
REDIS_URL=redis://localhost:6379/0

# Application secret — replace with a long random string before deploying
SECRET_KEY=replace-this-with-a-random-string-before-production

# Environment: development | production
ENVIRONMENT=development

# Active component data provider (single provider; used only when PROVIDER_FALLBACK_ORDER is not set).
# Registered providers: oemsecrets (default), nexar, findchips, digikey_mouser, mouser, digikey, nextpcb
COMPONENT_PROVIDER=oemsecrets

# Ordered fallback chain — comma-separated provider names.
# When set, PROVIDER_FALLBACK_ORDER takes precedence over COMPONENT_PROVIDER.
# Providers with missing credentials are skipped automatically.
PROVIDER_FALLBACK_ORDER=oemsecrets,nextpcb,mouser,digikey

# OEMSecrets API key (https://oemsecretsapi.com)
OEMSECRETS_API_KEY=

# Nexar Supply API credentials (https://nexar.com/api)
NEXAR_CLIENT_ID=
NEXAR_CLIENT_SECRET=

# DigiKey / Mouser credentials (future)
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
MOUSER_API_KEY=

# NextPCB component search credentials (https://www.nextpcb.com/api)
NEXTPCB_APP_ID=
NEXTPCB_APP_SECRET=

# Freemium plan limits (free tier defaults; override per-user via DB columns)
FREE_PLAN_MAX_PROJECTS=3
FREE_PLAN_MAX_PARTS_PER_PROJECT=50

# Application base URL (used in email links — no trailing slash)
APP_BASE_URL=http://localhost:5173

# Paddle Billing
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_ID_PRO_MONTHLY=
PADDLE_ENVIRONMENT=sandbox

# SMTP (transactional email — Resend recommended)
# Port 465 = implicit TLS (SMTP_SSL); port 587 = STARTTLS
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=
# Must match a verified sending domain in your email provider
EMAIL_FROM=noreply@email.yourdomain.com

# Anthropic (AI features — NL BOM query)
ANTHROPIC_API_KEY=

# Internal trial provisioning (webhook secret for n8n → /billing/internal/provision-trial)
INTERNAL_PROVISIONING_TOKEN=
