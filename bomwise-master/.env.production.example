# =============================================================================
# BOMExplorer — Production Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values:
#   cp .env.production.example .env
# Then edit .env with your actual secrets.
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
ENVIRONMENT=production
SECRET_KEY=replace-with-a-long-random-string
APP_BASE_URL=https://app.bomexplorer.app

# ---------------------------------------------------------------------------
# Version (set by deploy script or manually)
# ---------------------------------------------------------------------------
APP_VERSION=1.0.0
GIT_COMMIT=unknown

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_USER=bomexplorer
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=bomexplorer
# Docker compose builds this into the connection string internally:
#   DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres/${POSTGRES_DB}

# ---------------------------------------------------------------------------
# Redis (used by Celery)
# ---------------------------------------------------------------------------
# No env var needed — docker-compose.prod.yml sets redis://redis:6379/0

# ---------------------------------------------------------------------------
# Provider Configuration
# ---------------------------------------------------------------------------
# Active component data provider
COMPONENT_PROVIDER=oemsecrets

# Ordered fallback chain — comma-separated provider names
PROVIDER_FALLBACK_ORDER=oemsecrets,nextpcb,mouser,digikey

# OEMSecrets API key (https://oemsecretsapi.com)
OEMSECRETS_API_KEY=

# Nexar Supply API credentials (https://nexar.com/api)
NEXAR_CLIENT_ID=
NEXAR_CLIENT_SECRET=

# DigiKey / Mouser credentials
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
MOUSER_API_KEY=

# NextPCB component search credentials (https://www.nextpcb.com/api)
NEXTPCB_APP_ID=
NEXTPCB_APP_SECRET=

# ---------------------------------------------------------------------------
# Freemium plan limits
# ---------------------------------------------------------------------------
FREE_PLAN_MAX_PROJECTS=3
FREE_PLAN_MAX_PARTS_PER_PROJECT=50

# ---------------------------------------------------------------------------
# Email (SMTP — Resend recommended)
# Port 465 = implicit TLS (SMTP_SSL); port 587 = STARTTLS
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=
EMAIL_FROM=noreply@email.yourdomain.com

# ---------------------------------------------------------------------------
# Paddle Billing
# ---------------------------------------------------------------------------
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_ID_PRO_MONTHLY=
PADDLE_ENVIRONMENT=sandbox

# ---------------------------------------------------------------------------
# Anthropic (AI features — NL BOM query)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Internal trial provisioning (webhook secret for n8n)
# ---------------------------------------------------------------------------
INTERNAL_PROVISIONING_TOKEN=
